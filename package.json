{
  "name": "azar-neg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Azar Neɣ — marketplace de petites annonces algérienne, Cloudflare-native",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "wrangler dev --port 8787",
    "dev:web": "vite --port 5173",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:integration": "node scripts/test-integration.mjs",
    "test:all": "npm run test && npm run test:integration",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "demo:seed": "node scripts/seed-demo.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "admin:set-password": "node scripts/set-password.mjs",
    "types": "wrangler types",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "hono": "4.13.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1",
    "ws": "^8.18.3"
  }
}
